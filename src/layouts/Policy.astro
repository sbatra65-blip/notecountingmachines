---
// Layout for policy pages written in Markdown (src/pages/*.md with `layout: ../layouts/Policy.astro`).
import Base from './Base.astro';
import { SITE, SITE_NAME, publisher } from '../site.config';

const { frontmatter, url } = Astro.props;
const { title, description, updated } = frontmatter;
const pageUrl = SITE + (url ?? Astro.url.pathname);
const updatedDate = new Date(updated);
const schema = [
  publisher,
  {
    '@type': 'WebPage',
    name: title,
    description,
    url: pageUrl,
    dateModified: updatedDate.toISOString().slice(0, 10),
    publisher: { '@id': SITE + '/#org' },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE + '/' },
      { '@type': 'ListItem', position: 2, name: title, item: pageUrl },
    ],
  },
];
---
<Base title={`${title} | ${SITE_NAME}`} description={description} schema={schema}>
<div class="article-wrap">
  <article class="article" style="max-width: 820px">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">›</span><span>{title}</span></nav>
    <h1>{title}</h1>
    <div class="byline"><span>Last updated <strong>{updatedDate.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' })}</strong></span><span>Infinite Solutions, New Delhi</span></div>
    <div class="prose"><slot /></div>
  </article>
</div>
</Base>
