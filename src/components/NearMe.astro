---
// "Note counting machine near me" page in any language from src/i18n.ts.
// Used by /note-counting-machine-near-me/ and /<lang>/note-counting-machine-near-me/.
import Base from '../layouts/Base.astro';
import { MACHINES, machinePath, inr, tr } from '../data/machines';
import { UI, NEAR, LANGS, LANG_LIST, type Lang } from '../i18n';
import { SITE, store, publisher } from '../site.config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const pathFor = (l: Lang) => (l === 'en' ? '/note-counting-machine-near-me/' : `/${l}/note-counting-machine-near-me/`);
const url = SITE + pathFor(lang);
const L = NEAR[lang];
const U = UI[lang];
const mapUrl = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent('Vishwadeep Building, Janakpuri District Centre, Janakpuri, New Delhi 110058');
const phones = [['+918826035757', '88260 35757'], ['+918826035858', '88260 35858'], ['+918826035959', '88260 35959']];

const schema = [
  { ...store, hasMap: mapUrl },
  publisher,
  { '@type': 'WebPage', '@id': url, url, name: L.title, inLanguage: LANGS[lang].htmlLang, about: { '@id': SITE + '/#store' } },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: U.home, item: SITE + LANGS[lang].home },
      { '@type': 'ListItem', position: 2, name: L.h1, item: url },
    ],
  },
  { '@type': 'FAQPage', mainEntity: L.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
---
<Base title={L.title} description={L.desc} schema={schema} lang={LANGS[lang].htmlLang} alternates={Object.fromEntries(LANG_LIST.map((l) => [l, pathFor(l)]))}>
<div class="wrap" style="padding-top: 28px; padding-bottom: 64px">
  <nav class="crumbs" aria-label="Breadcrumb" style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;font-size:14px">
    <a href={LANGS[lang].home}>{U.home}</a><span aria-hidden="true">/</span><span>{U.nearMe}</span>
    <span style="margin-left:auto;display:flex;gap:12px">{LANG_LIST.filter((l) => l !== lang).map((l) => <a href={pathFor(l)} hreflang={l} lang={l} style="font-weight:600">{LANGS[l].label}</a>)}</span>
  </nav>

  <section style="display:flex;flex-wrap:wrap;gap:40px;align-items:flex-start;margin-top:20px">
    <div style="flex:1 1 480px;min-width:0;display:flex;flex-direction:column;gap:18px">
      <h1 style="margin:0;font-family:'Archivo',sans-serif;font-weight:800;font-size:clamp(30px,4.2vw,48px);line-height:1.12;letter-spacing:-0.01em">{L.h1}</h1>
      <p style="margin:0;font-size:18px;line-height:1.6;color:#33475B">{L.answer}</p>
      <a class="btn btn--amber" href="/#quote" style="align-self:flex-start">{L.quote}</a>
    </div>
    <div style="flex:1 1 360px;min-width:0;background:#FFFFFF;border:1px solid #DDE3E9;border-radius:20px;padding:28px;display:flex;flex-direction:column;gap:12px">
      <strong style="font-family:'Archivo',sans-serif;font-size:20px">{L.visit}</strong>
      <address style="font-style:normal;font-size:16px;line-height:1.6;color:#33475B">Infinite Solutions (NoteCountingMachines.com)<br>312, Plot No. 4, Vishwadeep Building,<br>Janakpuri District Centre, Janakpuri,<br>New Delhi 110058</address>
      <span style="font-size:15px;color:#33475B">{L.hours}</span>
      <span style="display:flex;flex-wrap:wrap;gap:6px 16px">{phones.map(([tel, label]) => <a href={`tel:${tel}`} style="color:#0B1F33;text-decoration:none;font-family:'Archivo',sans-serif;font-weight:800;font-size:18px">{label}</a>)}</span>
      <a href={mapUrl} target="_blank" rel="noopener" class="btn btn--ink" style="align-self:flex-start;font-size:15px">{L.map}</a>
    </div>
  </section>

  <section style="margin-top:56px">
    <h2 style="font-family:'Archivo',sans-serif;font-size:clamp(24px,3vw,34px);margin:0 0 16px">{L.areasH}</h2>
    <div style="overflow-x:auto;background:#FFFFFF;border:1px solid #DDE3E9;border-radius:14px">
      <table style="width:100%;border-collapse:collapse;font-size:15px">
        <thead><tr style="background:#0B1F33;color:#FFFFFF;text-align:left"><th scope="col" style="padding:12px 16px">{L.city}</th><th scope="col" style="padding:12px 16px">{L.where}</th></tr></thead>
        <tbody>{L.areas.map(([city, where]) => <tr style="border-top:1px solid #DDE3E9"><th scope="row" style="text-align:left;padding:12px 16px;white-space:nowrap">{city}</th><td style="padding:12px 16px;line-height:1.55">{where}</td></tr>)}</tbody>
      </table>
    </div>
  </section>

  <section style="margin-top:56px">
    <h2 style="font-family:'Archivo',sans-serif;font-size:clamp(24px,3vw,34px);margin:0 0 16px">{L.machinesH}</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px">
      {MACHINES.map((m) => (
        <a href={machinePath(m, lang)} style="text-decoration:none;background:#FFFFFF;border:1px solid #DDE3E9;border-radius:14px;padding:18px;display:flex;flex-direction:column;gap:8px">
          <img loading="lazy" decoding="async" src={m.image} alt={tr(m.name, lang)} style="width:100%;height:130px;object-fit:contain;mix-blend-mode:multiply">
          <strong style="font-family:'Archivo',sans-serif;font-size:17px;color:#0B1F33">{tr(m.name, lang)}</strong>
          <span style="font-size:14px;color:#52677C;line-height:1.5">{tr(m.short, lang)}</span>
          <span style="font-size:14px;font-weight:700;color:#0B1F33">{m.price ? `MRP ${inr(m.price)} →` : `${U.onRequest} →`}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="faq" style="margin-top:56px;max-width:820px">
    <h2>{U.faq}</h2>
    {L.faq.map(([q, a], i) => <details open={i === 0}><summary>{q}</summary><p>{a}</p></details>)}
  </section>
</div>
</Base>
