---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { allPosts, postUrl, categoryLabel, fmtDate, readMinutes, type Post } from '../lib/posts';
import { SITE, SITE_NAME, publisher, AMAZON_TOOLS } from '../site.config';
import { MACHINES, machinePath, tr } from '../data/machines';
import { LANGS } from '../i18n';

interface Props { post: Post }
const { post } = Astro.props;
const d = post.data;
const { Content } = await render(post);
const isNews = post.collection === 'news';
const url = SITE + postUrl(post);
const hubHref = isNews ? '/news/' : '/blog/';
const hubLabel = isNews ? 'Fake currency news' : 'Blog';
const lang = d.lang;
const A = {
  en: { tools: 'Tools that help with hand checks', disc: 'As an Amazon Associate we earn from qualifying purchases. Prices and products are set by Amazon sellers; a UV torch is a first check, not proof.', shop: 'See on Amazon', take: 'Key takeaways', cta: 'Catch fake notes at your counter', see: 'See the machine', faq: 'FAQ', src: 'Sources', rel: 'Related', alert: 'Stop fake notes at your counter', demo: 'Free demo in Delhi NCR. Call', or: 'or', book: 'Book a free demo', near: 'Find us near you →' },
  hi: { tools: 'हाथ से जांच के काम के औज़ार', disc: 'Amazon एसोसिएट के रूप में हम योग्य खरीदारी पर कमीशन कमाते हैं। कीमत और प्रोडक्ट Amazon विक्रेताओं के हैं; UV टॉर्च पहली जांच है, पक्का सबूत नहीं।', shop: 'Amazon पर देखें', take: 'मुख्य बातें', cta: 'काउंटर पर ही नकली नोट पकड़ें', see: 'मशीन देखें', faq: 'सवाल-जवाब', src: 'स्रोत', rel: 'और पढ़ें', alert: 'नकली नोट से बचें', demo: 'दिल्ली NCR में फ्री डेमो। कॉल करें', or: 'या', book: 'फ्री डेमो बुक करें', near: 'हमारा पता देखें →' },
  pa: { tools: 'ਹੱਥ ਨਾਲ ਜਾਂਚ ਲਈ ਕੰਮ ਦੇ ਸੰਦ', disc: 'Amazon ਐਸੋਸੀਏਟ ਵਜੋਂ ਅਸੀਂ ਯੋਗ ਖਰੀਦਦਾਰੀ ਉੱਤੇ ਕਮਿਸ਼ਨ ਕਮਾਉਂਦੇ ਹਾਂ। ਕੀਮਤ ਅਤੇ ਪ੍ਰੋਡਕਟ Amazon ਵਿਕਰੇਤਾਵਾਂ ਦੇ ਹਨ; UV ਟਾਰਚ ਪਹਿਲੀ ਜਾਂਚ ਹੈ, ਪੱਕਾ ਸਬੂਤ ਨਹੀਂ।', shop: 'Amazon ਉੱਤੇ ਵੇਖੋ', take: 'ਮੁੱਖ ਗੱਲਾਂ', cta: 'ਕਾਊਂਟਰ ਉੱਤੇ ਹੀ ਨਕਲੀ ਨੋਟ ਫੜੋ', see: 'ਮਸ਼ੀਨ ਵੇਖੋ', faq: 'ਸਵਾਲ-ਜਵਾਬ', src: 'ਸਰੋਤ', rel: 'ਹੋਰ ਪੜ੍ਹੋ', alert: 'ਨਕਲੀ ਨੋਟਾਂ ਤੋਂ ਬਚੋ', demo: 'ਦਿੱਲੀ NCR ਵਿੱਚ ਮੁਫ਼ਤ ਡੈਮੋ। ਕਾਲ ਕਰੋ', or: 'ਜਾਂ', book: 'ਮੁਫ਼ਤ ਡੈਮੋ ਬੁੱਕ ਕਰੋ', near: 'ਸਾਡਾ ਪਤਾ ਵੇਖੋ →' },
}[lang];
// The machine promoted at the end of the post, in the post's language.
const slugs = { t800: 't800-mix-value-note-counting-machine', t100: 't100-semi-value-note-counting-machine', ec442: 'kores-easycount-442-note-counting-machine' } as const;
const m = d.product !== 'none' ? MACHINES.find((x) => x.slug === slugs[d.product]) : undefined;
const product = m ? { img: m.image, name: tr(m.name, lang), blurb: tr(m.short, lang) + (m.price ? ` MRP ₹${m.price.toLocaleString('en-IN')}.` : ''), href: machinePath(m, lang) } : null;
const nearHref = lang === 'en' ? '/note-counting-machine-near-me/' : `/${lang}/note-counting-machine-near-me/`;
const related = (await allPosts()).filter((p) => p.id !== post.id).slice(0, 4);

// Dates are stored as plain days; publish them as 9:00 am IST so Google gets an explicit time zone.
const ist = (dt: Date) => dt.toISOString().slice(0, 10) + 'T09:00:00+05:30';
const articleImg = SITE + (product?.img ?? '/img/t800-mix-value-note-counting-machine.webp');

const schema = [
  publisher,
  {
    '@type': isNews ? 'NewsArticle' : 'BlogPosting',
    headline: d.title,
    description: d.description,
    inLanguage: LANGS[lang].htmlLang,
    datePublished: ist(d.pubDate),
    dateModified: ist(d.updatedDate ?? d.pubDate),
    // The byline is a team, not a person, so it is marked up as the organisation.
    author: { '@type': 'Organization', name: SITE_NAME, url: SITE + '/' },
    publisher: { '@id': SITE + '/#org' },
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    url,
    image: [articleImg],
    citation: d.sources.map((s) => s.url),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE + '/' },
      { '@type': 'ListItem', position: 2, name: hubLabel, item: SITE + hubHref },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
  ...(d.faq.length
    ? [{ '@type': 'FAQPage', mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }]
    : []),
];
---
<Base title={d.title.length > 50 ? d.title : `${d.title} | NoteCountingMachines.com`} description={d.description} type="article" schema={schema} lang={LANGS[lang].htmlLang} image={product?.img}>
<div class="article-wrap">
  <article class="article">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href={hubHref}>{hubLabel}</a><span aria-hidden="true">/</span><span>{categoryLabel(d.category)}</span></nav>
    <span class={`tag ${isNews ? 'tag--news' : 'tag--guide'}`} style="align-self:flex-start">{categoryLabel(d.category)}</span>
    <h1>{d.title}</h1>
    <div class="byline">
      <span>By <strong>{d.author}</strong></span>
      <a href="/editorial-policy/">How we check facts</a>
      <span>Published <time datetime={d.pubDate.toISOString()}>{fmtDate(d.pubDate, d.lang)}</time></span>
      {d.updatedDate && <span>Updated <time datetime={d.updatedDate.toISOString()}>{fmtDate(d.updatedDate, d.lang)}</time></span>}
      <span>{readMinutes(post.body)} min read</span>
    </div>

    {d.takeaways.length > 0 && (
      <div class="takeaways">
        <strong>{A.take}</strong>
        <ul>{d.takeaways.map((t) => <li>{t}</li>)}</ul>
      </div>
    )}

    <div class="prose"><Content /></div>

    {product && (
      <div class="product-cta">
        <div class="product-cta__img"><img src={product.img} alt={product.name} loading="lazy" width="180" height="124"></div>
        <div class="product-cta__text">
          <strong>{A.cta}</strong>
          <span>{product.name}: {product.blurb}</span>
        </div>
        <a class="btn btn--amber" href={product.href}>{A.see}</a>
      </div>
    )}

    {d.amazonTools && (
      <aside class="amazon-tools" aria-label={A.tools} style="margin-top:28px;background:#FFFFFF;border:1px solid #DDE3E9;border-radius:14px;padding:20px;display:flex;flex-direction:column;gap:12px">
        <strong style="font-family:'Archivo',sans-serif;font-size:19px">{A.tools}</strong>
        <ul style="list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px">
          {AMAZON_TOOLS.map((t) => (
            <li style="border:1px solid #DDE3E9;border-radius:10px;padding:12px 14px;display:flex;flex-direction:column;gap:6px">
              <strong style="font-size:16px">{t[lang][0]}</strong>
              <span style="font-size:14px;color:#52677C;line-height:1.5">{t[lang][1]}</span>
              <a href={t.url} rel="sponsored nofollow noopener" target="_blank" style="font-weight:700;font-size:14px;margin-top:auto">{A.shop} →</a>
            </li>
          ))}
        </ul>
        <small style="font-size:12px;color:#52677C;line-height:1.5">{A.disc}</small>
      </aside>
    )}

    {d.faq.length > 0 && (
      <section class="faq">
        <h2>{A.faq}</h2>
        {d.faq.map((f, i) => <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </section>
    )}

    {d.sources.length > 0 && (
      <div class="sources">
        <strong>{A.src}</strong>
        <ul style="margin:6px 0 0;padding-left:18px">{d.sources.map((s) => <li><a href={s.url} rel="nofollow noopener" target="_blank">{s.title}</a></li>)}</ul>
      </div>
    )}
  </article>

  <aside class="side" aria-label="More from the blog">
    <div class="side__box">
      <strong>{A.rel}</strong>
      {related.map((p) => <a href={postUrl(p)}>{p.data.title}</a>)}
    </div>
    <div class="side__alert">
      <strong style="font-family:'Archivo',sans-serif;font-size:18px">{A.alert}</strong>
      <span>{A.demo} <a href="tel:+918826035757">88260 35757</a>, <a href="tel:+918826035858">88260 35858</a> {A.or} <a href="tel:+918826035959">88260 35959</a>.</span>
      <a class="btn btn--ink" style="align-self:flex-start;font-size:14px" href="/#quote">{A.book}</a>
      <a href={nearHref} style="font-size:14px;font-weight:600">{A.near}</a>
    </div>
  </aside>
</div>
</Base>
