---
// Language dropdown in the header.
// Top part: our own translated pages (indexed by Google). Bottom part: other Indian languages through
// Google Translate, which opens a translated copy of the current page on Google's site, so no third-party
// script runs on ours and the Content-Security-Policy stays strict.
import { LANGS, LANG_LIST, type Alternates, type Lang } from '../i18n';
import { SITE } from '../site.config';

interface Props { alternates?: Alternates; lang?: string }
const { alternates = {}, lang = 'en-IN' } = Astro.props;
const current = (LANG_LIST.find((l) => LANGS[l].htmlLang === lang) ?? 'en') as Lang;
const pageUrl = new URL(Astro.url.pathname, SITE).href;

// Google language codes with names written in their own script.
const others = [
  ['bn', 'বাংলা', 'Bengali'], ['gu', 'ગુજરાતી', 'Gujarati'], ['mr', 'मराठी', 'Marathi'], ['ta', 'தமிழ்', 'Tamil'],
  ['te', 'తెలుగు', 'Telugu'], ['kn', 'ಕನ್ನಡ', 'Kannada'], ['ml', 'മലയാളം', 'Malayalam'], ['or', 'ଓଡ଼ିଆ', 'Odia'],
  ['as', 'অসমীয়া', 'Assamese'], ['ur', 'اردو', 'Urdu'],
];
const gt = (tl: string) => `https://translate.google.com/translate?sl=auto&tl=${tl}&u=${encodeURIComponent(pageUrl)}`;
---
<a class="lang-en notranslate" translate="no" href={alternates.en ?? (current === 'en' ? Astro.url.pathname : '/')} hreflang="en" lang="en" aria-current={current === 'en' ? 'true' : undefined}>English</a>
<details class="lang-menu notranslate" translate="no">
  <summary aria-label="Choose an Indian language">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
    <span lang={current === 'en' ? 'hi' : current}>{current === 'en' ? 'भाषा' : LANGS[current].label}</span>
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
  </summary>
  <div class="lang-menu__panel">
    <ul class="lang-menu__own">
      {LANG_LIST.filter((l) => l !== 'en').map((l) => (
        <li><a href={alternates[l] ?? (l === current ? Astro.url.pathname : LANGS[l].home)} hreflang={l} lang={l} aria-current={l === current ? 'true' : undefined}>{LANGS[l].label}</a></li>
      ))}
    </ul>
    <span class="lang-menu__note">Other languages · Google Translate</span>
    <ul class="lang-menu__other">
      {others.map(([code, native, en]) => (
        <li><a href={gt(code)} lang={code} rel="nofollow noopener" target="_blank" title={`${en} (Google Translate)`}>{native}</a></li>
      ))}
    </ul>
  </div>
</details>

<script>
  // Close the menu when the visitor clicks elsewhere or presses Escape.
  document.addEventListener('click', (e) => {
    document.querySelectorAll<HTMLDetailsElement>('details.lang-menu[open]').forEach((d) => {
      if (!d.contains(e.target as Node)) d.open = false;
    });
  });
  // Shift the panel sideways so it always fits on screen, wherever the button wraps to.
  document.querySelectorAll<HTMLDetailsElement>('details.lang-menu').forEach((d) => {
    d.addEventListener('toggle', () => {
      const panel = d.querySelector<HTMLElement>('.lang-menu__panel');
      if (!d.open || !panel) return;
      const left = d.getBoundingClientRect().left;
      const vw = document.documentElement.clientWidth;
      const pw = panel.offsetWidth;
      panel.style.left = Math.max(8 - left, Math.min(0, vw - 8 - left - pw)) + 'px';
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') document.querySelectorAll<HTMLDetailsElement>('details.lang-menu[open]').forEach((d) => (d.open = false));
  });
</script>
