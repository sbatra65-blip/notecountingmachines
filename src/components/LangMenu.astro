---
// Language dropdown in the header.
// Top part: our own translated pages (indexed by Google). Bottom part: other Indian languages through
// Google Translate, which opens a translated copy of the current page on Google's site, so no third-party
// script runs on ours and the Content-Security-Policy stays strict.
import { LANGS, LANG_LIST, type Alternates, type Lang } from '../i18n';
import { SITE } from '../site.config';

interface Props { alternates?: Alternates; lang?: string }
const { alternates = {}, lang = 'en-IN' } = Astro.props;
const current = (LANG_LIST.find((l) => LANGS[l].htmlLang === lang) ?? 'en') as Lang;
const pageUrl = new URL(Astro.url.pathname, SITE).href;

// Google language codes with names written in their own script.
const others = [
  ['bn', 'বাংলা', 'Bengali'], ['gu', 'ગુજરાતી', 'Gujarati'], ['mr', 'मराठी', 'Marathi'], ['ta', 'தமிழ்', 'Tamil'],
  ['te', 'తెలుగు', 'Telugu'], ['kn', 'ಕನ್ನಡ', 'Kannada'], ['ml', 'മലയാളം', 'Malayalam'], ['or', 'ଓଡ଼ିଆ', 'Odia'],
  ['as', 'অসমীয়া', 'Assamese'], ['ur', 'اردو', 'Urdu'],
];
// Styles are inline (like the rest of the header) so the buttons look the same on Google Translate's copy of
// the page, which does not always load our stylesheet.
const font = "'Public Sans', 'Noto Sans Devanagari', 'Noto Sans Gurmukhi', system-ui, sans-serif";
const btn = `display: inline-flex; align-items: center; box-sizing: border-box; min-height: 44px; padding: 0 12px; border-radius: 8px; text-decoration: none; font-family: ${font}; font-size: 15px; font-weight: 600; line-height: 1; `;
const on = 'background: #FFF4D6; border: 1px solid #F2A900; color: #6B4C00;';
const off = 'background: #FFFFFF; border: 1px solid #B8C4CF; color: #0B1F33;';
const ownHref = (l: Lang) => alternates[l] ?? (l === current ? Astro.url.pathname : LANGS[l].home);
const enHref = ownHref('en');
const gt = (tl: string) => `https://translate.google.com/translate?sl=auto&tl=${tl}&u=${encodeURIComponent(pageUrl)}`;
---
<a class="lang-en notranslate" translate="no" href={enHref} data-real={SITE + enHref} hreflang="en" lang="en" aria-current={current === 'en' ? 'true' : undefined} style={`${btn}${current === 'en' ? on : off}`}>English</a>
<details class="lang-menu notranslate" translate="no" style="position: relative">
  <summary aria-label="Choose an Indian language" style={`${btn}gap: 6px; cursor: pointer; list-style: none; ${current !== 'en' ? on : off}`}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
    <span lang={current === 'en' ? 'hi' : current}>{current === 'en' ? 'भाषा' : LANGS[current].label}</span>
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
  </summary>
  <div class="lang-menu__panel" style="position: absolute; left: 0; top: calc(100% + 6px); z-index: 50; width: min(300px, calc(100vw - 32px)); box-sizing: border-box; background: #FFFFFF; border: 1px solid #DDE3E9; border-radius: 12px; box-shadow: 0 12px 32px rgba(11, 31, 51, 0.16); padding: 10px; display: flex; flex-direction: column; gap: 8px">
    <ul class="lang-menu__own" style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column">
      {LANG_LIST.filter((l) => l !== 'en').map((l) => (
        <li><a href={ownHref(l)} data-real={SITE + ownHref(l)} hreflang={l} lang={l} aria-current={l === current ? 'true' : undefined} style={`display: block; padding: 10px 12px; border-radius: 8px; text-decoration: none; font-family: ${font}; font-weight: 600; font-size: 16px; ${l === current ? 'background: #FFF4D6; color: #6B4C00' : 'color: #0B1F33'}`}>{LANGS[l].label}</a></li>
      ))}
    </ul>
    <span class="lang-menu__note" style={`font-family: ${font}; font-size: 12px; font-weight: 700; letter-spacing: 0.04em; color: #52677C; padding: 10px 12px 0; border-top: 1px solid #DDE3E9`}>Other languages · Google Translate</span>
    <ul class="lang-menu__other" style="list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2px">
      {others.map(([code, native, en]) => (
        <li><a href={gt(code)} data-real={gt(code)} lang={code} rel="nofollow noopener" target="_blank" title={`${en} (Google Translate)`} style={`display: block; padding: 8px 12px; border-radius: 8px; text-decoration: none; font-family: ${font}; font-size: 15px; color: #33475B`}>{native}</a></li>
      ))}
    </ul>
  </div>
</details>

<script>
  // On Google Translate's copy (www-notecountingmachines-com.translate.goog) Google rewrites every link to stay
  // inside its proxy, and repeated proxied clicks can trigger Google's "unusual traffic" block. So when the page
  // is being viewed through the proxy, the language links leave it and go straight to the real site
  // (or to a fresh Google Translate copy for the other languages).
  if (location.hostname.endsWith('.translate.goog')) {
    document.querySelectorAll<HTMLAnchorElement>('a[data-real]').forEach((a) => {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        const url = a.dataset.real!;
        try { (window.top ?? window).location.href = url; } catch { window.location.href = url; }
      });
    });
  }

  // Close the menu when the visitor clicks elsewhere or presses Escape.
  document.addEventListener('click', (e) => {
    document.querySelectorAll<HTMLDetailsElement>('details.lang-menu[open]').forEach((d) => {
      if (!d.contains(e.target as Node)) d.open = false;
    });
  });
  // Shift the panel sideways so it always fits on screen, wherever the button wraps to.
  document.querySelectorAll<HTMLDetailsElement>('details.lang-menu').forEach((d) => {
    d.addEventListener('toggle', () => {
      const panel = d.querySelector<HTMLElement>('.lang-menu__panel');
      if (!d.open || !panel) return;
      const left = d.getBoundingClientRect().left;
      const vw = document.documentElement.clientWidth;
      const pw = panel.offsetWidth;
      panel.style.left = Math.max(8 - left, Math.min(0, vw - 8 - left - pw)) + 'px';
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') document.querySelectorAll<HTMLDetailsElement>('details.lang-menu[open]').forEach((d) => (d.open = false));
  });
</script>
