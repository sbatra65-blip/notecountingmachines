---
import Base from '../layouts/Base.astro';
import { SITE, store } from '../site.config';

const faqs = [
  {
    "q": "How does a note counting machine detect fake notes?",
    "a": "It checks each note with UV light (paper and ink fluorescence), MG (magnetic ink), IR (infrared print) and MT (security thread) sensors, and stops with an alert when a note fails. CIS machines also scan the full image of the note."
  },
  {
    "q": "What is the price of a note counting machine in India?",
    "a": "Loose note counters with fake note detection cost ₹13,750 MRP (Kores EasyCount 442), semi value counters ₹13,990 (T-100) and mix value counters ₹24,990 (T-800). Bank bundle counters and note sorters are priced on request."
  },
  {
    "q": "Which note counting machine is used in banks?",
    "a": "Banks use bundle note counters for stapled packets and CIS-based value counters or note sorters, such as the Kores Kashpro and iH110, at the cash counter."
  },
  {
    "q": "Is a note counting machine RBI approved?",
    "a": "RBI does not approve individual brands. It sets detection standards for banks; ask for a machine with UV, MG and IR (or CIS) detection that takes software updates for new notes."
  },
  {
    "q": "Do you give a demo and warranty in Delhi NCR?",
    "a": "Yes. Free demo at your shop or office in Delhi NCR, 1-year onsite warranty on Pacific International machines and manufacturer warranty on Kores, with a GST invoice."
  }
];

const products = [
  { name: 'T-800 Mix Value Note Counting Machine', brand: 'Pacific International', image: '/img/t800-mix-value-note-counting-machine.webp', price: '24990',
    description: 'Mix value counting machine with UV, MG, IR, MT fake note detection, 1,200 notes/min, 250-note hopper, colour TFT display.' },
  { name: 'T-100 Semi Value Note Counting Machine', brand: 'Pacific International', image: '/img/t100-semi-value-note-counting-machine.webp', price: '13990',
    description: 'Semi value loose note counter with UV, MG, IR, MT detection, double/half/chain note detection, 1,200 notes/min.' },
  { name: 'Kores EasyCount 442 Note Counting Machine', brand: 'Kores', image: '/img/kores-easycount-442-note-counting-machine.webp', price: '13750',
    description: 'Loose note counting machine with UV, MG, IR fake note detection, 900 notes/min, batch and preset counting, 5-hour continuous run.' },
];

const schema = [
  store,
  {
    '@type': 'ItemList',
    name: 'Note counting machines',
    itemListElement: products.map((p, i) => ({
      '@type': 'ListItem', position: i + 1,
      item: { '@type': 'Product', name: p.name, brand: { '@type': 'Brand', name: p.brand }, image: SITE + p.image, description: p.description,
        offers: { '@type': 'Offer', price: p.price, priceCurrency: 'INR', availability: 'https://schema.org/InStock', seller: { '@id': SITE + '/#store' } } },
    })),
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
