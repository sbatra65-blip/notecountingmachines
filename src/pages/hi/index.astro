---
// Hindi home: नोट गिनने की मशीन. Lists Hindi product pages and Hindi posts.
import Base from '../../layouts/Base.astro';
import { MACHINES, machinePath, inr } from '../../data/machines';
import { allPosts, postUrl, fmtDate } from '../../lib/posts';
import { SITE, store, publisher } from '../../site.config';
import { LANGS, LANG_LIST } from '../../i18n';

const hindiPosts = (await allPosts()).filter((p) => p.data.lang === 'hi');

const faqs = [
  { q: 'नोट गिनने की मशीन की कीमत कितनी है?', a: 'नकली नोट जांच वाली मशीन ₹13,750 (कोरस ईज़ीकाउंट 442), सेमी वैल्यू ₹13,990 (T-100) और मिक्स वैल्यू ₹24,990 (T-800), सभी GST सहित। बैंक के बंडल काउंटर और सॉर्टर की कीमत के लिए कॉल करें।' },
  { q: 'नोट गिनने की मशीन नकली नोट कैसे पकड़ती है?', a: 'मशीन हर नोट को UV, MG, IR और MT सेंसर से जांचती है और नकली नोट मिलते ही रुककर अलार्म देती है। CIS मशीनें पूरे नोट की तस्वीर भी स्कैन करती हैं।' },
  { q: 'क्या नोट गिनने की मशीन RBI से मान्यता प्राप्त होती है?', a: 'RBI किसी ब्रांड को मान्यता नहीं देता। UV, MG और IR (या CIS) जांच वाली और नए नोटों के लिए सॉफ्टवेयर अपडेट लेने वाली मशीन चुनें।' },
  { q: 'क्या आप दिल्ली NCR में डेमो देते हैं?', a: 'हां। दिल्ली, गुड़गांव, नोएडा, फरीदाबाद और गाज़ियाबाद में दुकान या ऑफिस पर फ्री डेमो, GST बिल के साथ।' },
];

const schema = [
  store,
  publisher,
  { '@type': 'WebPage', '@id': SITE + '/hi/', url: SITE + '/hi/', name: 'नोट गिनने की मशीन', inLanguage: 'hi-IN', about: { '@id': SITE + '/#store' } },
  { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base
  title="नोट गिनने की मशीन – नकली नोट जांच वाली, कीमत और डेमो"
  description="नकली नोट पकड़ने वाली नोट गिनने की मशीन, कैश काउंटिंग और मिक्स वैल्यू मशीन। कीमत ₹13,750 से। दिल्ली NCR में दुकान पर फ्री डेमो, GST बिल।"
  schema={schema}
  lang="hi-IN"
  alternates={Object.fromEntries(LANG_LIST.map((l) => [l, LANGS[l].home]))}
>
<div class="wrap" style="padding-top: 40px; padding-bottom: 64px">
  <nav style="display:flex;justify-content:flex-end;gap:12px;font-size:14px">{LANG_LIST.filter((l) => l !== 'hi').map((l) => <a href={LANGS[l].home} hreflang={l} lang={l} style="font-weight:600">{LANGS[l].label}</a>)}</nav>

  <section style="display:flex;flex-direction:column;gap:18px;max-width:820px">
    <h1 style="margin:0;font-family:'Archivo','Noto Sans Devanagari',sans-serif;font-weight:800;font-size:clamp(32px,4.6vw,54px);line-height:1.15">नकली नोट पकड़ने वाली नोट गिनने की मशीन</h1>
    <p style="margin:0;font-size:19px;line-height:1.65;color:#33475B">कैश काउंटिंग मशीन, करेंसी काउंटिंग मशीन और मिक्स वैल्यू मशीन, जो 1,200 नोट प्रति मिनट तक गिनती हैं और UV, MG, IR और MT सेंसर से नकली नोट पकड़ती हैं। दिल्ली, गुड़गांव, नोएडा, फरीदाबाद और गाज़ियाबाद में फ्री डेमो, GST बिल और सर्विस।</p>
    <div style="display:flex;flex-wrap:wrap;gap:12px;align-items:center">
      <a class="btn btn--amber" href="/#quote">फ्री डेमो / कोटेशन</a>
      <span style="font-weight:600;color:#33475B">कॉल करें: <a href="tel:+918826035757" style="color:#0B1F33;font-weight:800">88260 35757</a> · <a href="tel:+918826035858" style="color:#0B1F33;font-weight:800">88260 35858</a> · <a href="tel:+918826035959" style="color:#0B1F33;font-weight:800">88260 35959</a></span>
    </div>
  </section>

  <section style="margin-top:56px">
    <h2 style="font-family:'Archivo',sans-serif;font-size:clamp(24px,3vw,34px);margin:0 0 16px">मशीनें और कीमत</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px">
      {MACHINES.map((m) => (
        <a href={machinePath(m, 'hi')} style="text-decoration:none;background:#FFFFFF;border:1px solid #DDE3E9;border-radius:14px;padding:18px;display:flex;flex-direction:column;gap:8px">
          <img loading="lazy" decoding="async" src={m.image} alt={m.name.hi} style="width:100%;height:140px;object-fit:contain;mix-blend-mode:multiply">
          <span style="font-size:12px;font-weight:700;color:#52677C">{m.type.hi}</span>
          <strong style="font-size:17px;color:#0B1F33">{m.name.hi}</strong>
          <span style="font-size:14px;color:#52677C;line-height:1.5">{m.short.hi}</span>
          <span style="font-size:14px;font-weight:700;color:#0B1F33">{m.price ? `MRP ${inr(m.price)} →` : 'कीमत के लिए कॉल करें →'}</span>
        </a>
      ))}
    </div>
  </section>

  <section style="margin-top:48px;background:#0B1F33;color:#FFFFFF;border-radius:20px;padding:32px;display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between;align-items:center">
    <div style="display:flex;flex-direction:column;gap:6px;max-width:640px">
      <h2 style="margin:0;font-family:'Archivo',sans-serif;font-size:26px">मेरे पास नोट गिनने की मशीन कहां मिलेगी?</h2>
      <p style="margin:0;color:#C5D0DB;line-height:1.6">हमारा ऑफिस जनकपुरी डिस्ट्रिक्ट सेंटर, नई दिल्ली में है। पूरे दिल्ली NCR में दुकान पर फ्री डेमो।</p>
    </div>
    <a class="btn btn--amber" href="/hi/note-counting-machine-near-me/">पता और इलाके देखें</a>
  </section>

  {hindiPosts.length > 0 && (
    <section style="margin-top:56px">
      <h2 style="font-family:'Archivo',sans-serif;font-size:clamp(24px,3vw,34px);margin:0 0 16px">हिंदी गाइड और नकली नोट समाचार</h2>
      <ul style="list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:12px">
        {hindiPosts.map((p) => (
          <li style="background:#FFFFFF;border:1px solid #DDE3E9;border-radius:12px;padding:16px 18px;display:flex;flex-direction:column;gap:6px">
            <a href={postUrl(p)} style="font-weight:700;font-size:17px;color:#0B1F33;text-decoration:none">{p.data.title}</a>
            <span style="font-size:14px;color:#52677C;line-height:1.5">{p.data.description}</span>
            <span style="font-size:13px;color:#52677C">{fmtDate(p.data.pubDate, 'hi')}</span>
          </li>
        ))}
      </ul>
      <p style="margin:16px 0 0"><a href="/blog/category/hindi/" style="font-weight:600">सभी हिंदी लेख →</a></p>
    </section>
  )}

  <section class="faq" style="margin-top:56px;max-width:820px">
    <h2>सवाल-जवाब</h2>
    {faqs.map((f, i) => <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>)}
  </section>
</div>
</Base>
