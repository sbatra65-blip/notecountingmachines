---
// Punjabi home: ਨੋਟ ਗਿਣਨ ਵਾਲੀ ਮਸ਼ੀਨ. Lists Punjabi product pages.
import Base from '../../layouts/Base.astro';
import { MACHINES, machinePath, inr, tr } from '../../data/machines';
import { LANGS, LANG_LIST } from '../../i18n';
import { SITE, store, publisher } from '../../site.config';

const faqs = [
  { q: 'ਨੋਟ ਗਿਣਨ ਵਾਲੀ ਮਸ਼ੀਨ ਦੀ ਕੀਮਤ ਕਿੰਨੀ ਹੈ?', a: 'ਨਕਲੀ ਨੋਟ ਜਾਂਚ ਵਾਲੀ ਮਸ਼ੀਨ ₹13,750 (ਕੋਰਸ ਈਜ਼ੀਕਾਊਂਟ 442), ਸੈਮੀ ਵੈਲਿਊ ₹13,990 (T-100) ਅਤੇ ਮਿਕਸ ਵੈਲਿਊ ₹24,990 (T-800), ਸਾਰੀਆਂ GST ਸਮੇਤ। ਬੈਂਕਾਂ ਦੇ ਬੰਡਲ ਕਾਊਂਟਰ ਅਤੇ ਸੌਰਟਰ ਦੀ ਕੀਮਤ ਲਈ ਕਾਲ ਕਰੋ।' },
  { q: 'ਨੋਟ ਗਿਣਨ ਵਾਲੀ ਮਸ਼ੀਨ ਨਕਲੀ ਨੋਟ ਕਿਵੇਂ ਫੜਦੀ ਹੈ?', a: 'ਮਸ਼ੀਨ ਹਰ ਨੋਟ ਨੂੰ UV, MG, IR ਅਤੇ MT ਸੈਂਸਰਾਂ ਨਾਲ ਜਾਂਚਦੀ ਹੈ ਅਤੇ ਨਕਲੀ ਨੋਟ ਮਿਲਦੇ ਹੀ ਰੁਕ ਕੇ ਅਲਾਰਮ ਦਿੰਦੀ ਹੈ। CIS ਮਸ਼ੀਨਾਂ ਪੂਰੇ ਨੋਟ ਦੀ ਤਸਵੀਰ ਵੀ ਸਕੈਨ ਕਰਦੀਆਂ ਹਨ।' },
  { q: 'ਕੀ ਨੋਟ ਗਿਣਨ ਵਾਲੀ ਮਸ਼ੀਨ RBI ਤੋਂ ਮਨਜ਼ੂਰਸ਼ੁਦਾ ਹੁੰਦੀ ਹੈ?', a: 'RBI ਕਿਸੇ ਬ੍ਰਾਂਡ ਨੂੰ ਮਨਜ਼ੂਰੀ ਨਹੀਂ ਦਿੰਦਾ। UV, MG ਅਤੇ IR (ਜਾਂ CIS) ਜਾਂਚ ਵਾਲੀ ਅਤੇ ਨਵੇਂ ਨੋਟਾਂ ਲਈ ਸਾਫ਼ਟਵੇਅਰ ਅੱਪਡੇਟ ਲੈਣ ਵਾਲੀ ਮਸ਼ੀਨ ਚੁਣੋ।' },
  { q: 'ਕੀ ਤੁਸੀਂ ਪੰਜਾਬ ਵਿੱਚ ਮਸ਼ੀਨ ਭੇਜਦੇ ਹੋ?', a: 'ਹਾਂ। ਪੰਜਾਬ ਸਮੇਤ ਪੂਰੇ ਭਾਰਤ ਵਿੱਚ ਕੂਰੀਅਰ ਰਾਹੀਂ ਡਿਲੀਵਰੀ (ਡਿਲੀਵਰੀ ਖ਼ਰਚਾ ਵੱਖਰਾ), GST ਬਿੱਲ ਅਤੇ ਫ਼ੋਨ ਉੱਤੇ ਸਪੋਰਟ। ਦਿੱਲੀ NCR ਵਿੱਚ ਦੁਕਾਨ ਉੱਤੇ ਮੁਫ਼ਤ ਡੈਮੋ।' },
];

const schema = [
  store,
  publisher,
  { '@type': 'WebPage', '@id': SITE + '/pa/', url: SITE + '/pa/', name: 'ਨੋਟ ਗਿਣਨ ਵਾਲੀ ਮਸ਼ੀਨ', inLanguage: 'pa-IN', about: { '@id': SITE + '/#store' } },
  { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base
  title="ਨੋਟ ਗਿਣਨ ਵਾਲੀ ਮਸ਼ੀਨ – ਨਕਲੀ ਨੋਟ ਜਾਂਚ, ਕੀਮਤ ਅਤੇ ਡੈਮੋ"
  description="ਨਕਲੀ ਨੋਟ ਫੜਨ ਵਾਲੀ ਨੋਟ ਗਿਣਨ ਵਾਲੀ ਮਸ਼ੀਨ, ਕੈਸ਼ ਕਾਊਂਟਿੰਗ ਅਤੇ ਮਿਕਸ ਵੈਲਿਊ ਮਸ਼ੀਨ। ਕੀਮਤ ₹13,750 ਤੋਂ। ਦਿੱਲੀ NCR ਵਿੱਚ ਮੁਫ਼ਤ ਡੈਮੋ, ਪੂਰੇ ਭਾਰਤ ਵਿੱਚ ਡਿਲੀਵਰੀ।"
  schema={schema}
  lang="pa-IN"
  alternates={Object.fromEntries(LANG_LIST.map((l) => [l, LANGS[l].home]))}
>
<div class="wrap" style="padding-top: 40px; padding-bottom: 64px">
  <nav style="display:flex;justify-content:flex-end;gap:12px;font-size:14px">{LANG_LIST.filter((l) => l !== 'pa').map((l) => <a href={LANGS[l].home} hreflang={l} lang={l} style="font-weight:600">{LANGS[l].label}</a>)}</nav>

  <section style="display:flex;flex-direction:column;gap:18px;max-width:820px">
    <h1 style="margin:0;font-family:'Archivo','Noto Sans Gurmukhi',sans-serif;font-weight:800;font-size:clamp(32px,4.6vw,54px);line-height:1.2">ਨਕਲੀ ਨੋਟ ਫੜਨ ਵਾਲੀ ਨੋਟ ਗਿਣਨ ਵਾਲੀ ਮਸ਼ੀਨ</h1>
    <p style="margin:0;font-size:19px;line-height:1.65;color:#33475B">ਕੈਸ਼ ਕਾਊਂਟਿੰਗ ਮਸ਼ੀਨ, ਕਰੰਸੀ ਕਾਊਂਟਿੰਗ ਮਸ਼ੀਨ ਅਤੇ ਮਿਕਸ ਵੈਲਿਊ ਮਸ਼ੀਨ, ਜੋ 1,200 ਨੋਟ ਪ੍ਰਤੀ ਮਿੰਟ ਤੱਕ ਗਿਣਦੀਆਂ ਹਨ ਅਤੇ UV, MG, IR ਅਤੇ MT ਸੈਂਸਰਾਂ ਨਾਲ ਨਕਲੀ ਨੋਟ ਫੜਦੀਆਂ ਹਨ। ਦਿੱਲੀ NCR ਵਿੱਚ ਮੁਫ਼ਤ ਡੈਮੋ ਅਤੇ ਸਰਵਿਸ, ਪੰਜਾਬ ਸਮੇਤ ਪੂਰੇ ਭਾਰਤ ਵਿੱਚ ਡਿਲੀਵਰੀ, GST ਬਿੱਲ।</p>
    <div style="display:flex;flex-wrap:wrap;gap:12px;align-items:center">
      <a class="btn btn--amber" href="/#quote">ਮੁਫ਼ਤ ਡੈਮੋ / ਕੋਟੇਸ਼ਨ</a>
      <span style="font-weight:600;color:#33475B">ਕਾਲ ਕਰੋ: <a href="tel:+918826035757" style="color:#0B1F33;font-weight:800">88260 35757</a> · <a href="tel:+918826035858" style="color:#0B1F33;font-weight:800">88260 35858</a> · <a href="tel:+918826035959" style="color:#0B1F33;font-weight:800">88260 35959</a></span>
    </div>
  </section>

  <section style="margin-top:56px">
    <h2 style="font-family:'Archivo',sans-serif;font-size:clamp(24px,3vw,34px);margin:0 0 16px">ਮਸ਼ੀਨਾਂ ਅਤੇ ਕੀਮਤ</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px">
      {MACHINES.map((m) => (
        <a href={machinePath(m, 'pa')} style="text-decoration:none;background:#FFFFFF;border:1px solid #DDE3E9;border-radius:14px;padding:18px;display:flex;flex-direction:column;gap:8px">
          <img loading="lazy" decoding="async" src={m.image} alt={tr(m.name, 'pa')} style="width:100%;height:140px;object-fit:contain;mix-blend-mode:multiply">
          <span style="font-size:12px;font-weight:700;color:#52677C">{tr(m.type, 'pa')}</span>
          <strong style="font-size:17px;color:#0B1F33">{tr(m.name, 'pa')}</strong>
          <span style="font-size:14px;color:#52677C;line-height:1.5">{tr(m.short, 'pa')}</span>
          <span style="font-size:14px;font-weight:700;color:#0B1F33">{m.price ? `MRP ${inr(m.price)} →` : 'ਕੀਮਤ ਲਈ ਕਾਲ ਕਰੋ →'}</span>
        </a>
      ))}
    </div>
  </section>

  <section style="margin-top:48px;background:#0B1F33;color:#FFFFFF;border-radius:20px;padding:32px;display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between;align-items:center">
    <div style="display:flex;flex-direction:column;gap:6px;max-width:640px">
      <h2 style="margin:0;font-family:'Archivo',sans-serif;font-size:26px">ਮੇਰੇ ਨੇੜੇ ਨੋਟ ਗਿਣਨ ਵਾਲੀ ਮਸ਼ੀਨ ਕਿੱਥੇ ਮਿਲੇਗੀ?</h2>
      <p style="margin:0;color:#C5D0DB;line-height:1.6">ਸਾਡਾ ਦਫ਼ਤਰ ਜਨਕਪੁਰੀ ਡਿਸਟ੍ਰਿਕਟ ਸੈਂਟਰ, ਨਵੀਂ ਦਿੱਲੀ ਵਿੱਚ ਹੈ। ਪੂਰੇ ਦਿੱਲੀ NCR ਵਿੱਚ ਦੁਕਾਨ ਉੱਤੇ ਮੁਫ਼ਤ ਡੈਮੋ।</p>
    </div>
    <a class="btn btn--amber" href="/pa/note-counting-machine-near-me/">ਪਤਾ ਅਤੇ ਇਲਾਕੇ ਵੇਖੋ</a>
  </section>

  <section class="faq" style="margin-top:56px;max-width:820px">
    <h2>ਸਵਾਲ-ਜਵਾਬ</h2>
    {faqs.map((f, i) => <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>)}
  </section>
</div>
</Base>
